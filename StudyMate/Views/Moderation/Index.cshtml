@model IReadOnlyList<StudyMate.Models.Report>
@{ ViewData["Title"] = "Moderation"; }
<h1 class="page-title">Moderation queue</h1>
<p class="page-subtitle">Reports are reviewed here. This queue is visible only to administrators.</p>
@if (!Model.Any()) { <p class="text-muted">No open reports.</p> }
@foreach (var report in Model)
{
    <article class="rail-card mb-3">
        <div class="section-label">@report.Reason · @report.CreatedAt.ToString("d MMM")</div>
        @if (!string.IsNullOrWhiteSpace(report.Detail)) { <p class="mb-2">@report.Detail</p> }
        <form asp-action="Review" method="post" class="form-inline">
            <input type="hidden" name="id" value="@report.Id" />
            <input name="note" class="form-control form-control-sm mr-2" maxlength="1000" placeholder="Reviewer note" />
            <button name="suspend" value="false" class="btn btn-sm btn-outline-secondary mr-2">Dismiss</button>
            <button name="suspend" value="true" class="btn btn-sm btn-primary">Suspend student</button>
        </form>
    </article>
}
@{ var requests = (IReadOnlyList<StudyMate.Models.CourseRequest>)ViewBag.CourseRequests; }
<h2 class="section-label mt-4">Course requests</h2>
@foreach (var request in requests)
{
    <article class="rail-card mb-3"><strong>@request.Code — @request.Title</strong>
        <form asp-action="ReviewCourseRequest" method="post" class="form-inline mt-2"><input type="hidden" name="id" value="@request.Id" /><input name="note" class="form-control form-control-sm mr-2" placeholder="Reviewer note" /><button name="approve" value="false" class="btn btn-sm btn-outline-secondary mr-2">Reject</button><button name="approve" value="true" class="btn btn-sm btn-primary">Approve</button></form>
    </article>
}
