@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="empty-state text-center py-5">
    <p class="section-label mb-2">Error</p>
    <h1 class="h4 mb-2">Something went wrong on our end</h1>
    <p class="text-muted">
        The request could not be completed. Trying again, or heading back to the start, usually works.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the start</a>

    <p class="text-muted small mt-4 mb-0">
        Swapping to the <strong>Development</strong> environment shows more detail about what
        failed — set <strong>ASPNETCORE_ENVIRONMENT</strong> to <strong>Development</strong> and
        restart the app locally. It should never be enabled on a deployed instance, since it can
        expose exception details to end users.
    </p>
</div>
