<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <!-- Motion layer, Requirement A: adds `js` to <html> before any stylesheet
         paints, so every hidden-initial motion rule below can be scoped
         `html.js ...` and a no-JS visitor never has content hidden from them. -->
    <script>document.documentElement.classList.add('js');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StudyMate</title>
    <meta name="description" content="StudyMate ranks other students at your university by how well you'd actually study together — shared courses first, then overlapping availability, then how you like to work — and shows the reasoning behind every match." />
    <meta property="og:title" content="@ViewData["Title"] - StudyMate" />
    <meta property="og:description" content="Find a study partner ranked by shared courses, overlapping availability and how you like to work, with the reasoning shown for every match." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <link rel="icon" type="image/svg+xml" href="~/img/logo-mark.svg" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/img/logo-mark.svg" alt="" width="28" height="28" />
                    StudyMate
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between" id="mainNav">
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Matches" asp-action="Index">Matches</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Requests" asp-action="Index">Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Edit">Profile</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center">
                                @{
                                    var navStudentId = User.GetStudentId();
                                }
                                @if (navStudentId != null)
                                {
                                    <span class="avatar avatar-sm mr-2">
                                        @Html.Raw(StudyMate.Services.AvatarGenerator.SvgFor(navStudentId.Value, User.Identity.Name))
                                    </span>
                                }
                                <span class="navbar-text mr-2">@User.Identity.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                                    <button type="submit" class="nav-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" id="main-content" class="pb-3 page-fade">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top text-muted">
        <div class="container py-3 small">
            StudyMate — demonstration deployment with fictional data.
            <a asp-controller="Home" asp-action="Privacy">About this deployment</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
