@model IReadOnlyList<MatchResult>
@{
    ViewData["Title"] = "Your matches";
    var current = Model.FirstOrDefault();
    var remaining = Model.Count;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Your matches</h1>
        @if (remaining > 0)
        {
            <span class="text-muted small">@remaining to review</span>
        }
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="List">See all matches</a>
</div>

@if (TempData["Sent"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Sent"]</div>
}

@if (current == null)
{
    <div class="empty-state text-center py-5">
        <h2 class="h5">You have reviewed everyone for now</h2>
        <p class="text-muted">
            There is nobody left in your deck. Adding more courses or availability to your
            profile will widen the pool.
        </p>
        <a class="btn btn-primary" asp-controller="Profile" asp-action="Edit">Update your profile</a>
        <a class="btn btn-link" asp-controller="Requests" asp-action="Index">See your requests</a>
    </div>
}
else
{
    <div class="deck">
        @* Purely decorative: hints that more candidates are queued behind this one. *@
        @if (remaining > 2) { <div class="deck-shadow deck-shadow-2" aria-hidden="true"></div> }
        @if (remaining > 1) { <div class="deck-shadow deck-shadow-1" aria-hidden="true"></div> }

        <article class="card match-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <h2 class="h4 mb-1">@current.Candidate.Name</h2>
                        <p class="text-muted mb-0 small">
                            @current.Candidate.Major · Year @current.Candidate.Year
                        </p>
                    </div>
                    <div class="score" title="Match score out of 100">
                        <span class="score-value">@current.Score</span>
                        <span class="score-max">/100</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(current.Candidate.Bio))
                {
                    <p class="bio">@current.Candidate.Bio</p>
                }

                <h3 class="h6 text-uppercase text-muted reasons-heading">Why you matched</h3>
                <ul class="reasons list-unstyled mb-0">
                    @foreach (var reason in current.Reasons)
                    {
                        <li class="reason">
                            <span class="reason-points">+@reason.Points</span>
                            <span class="reason-text">@reason.Text</span>
                        </li>
                    }
                    @if (!current.Reasons.Any())
                    {
                        <li class="text-muted small">Nothing in common yet — try adding more courses to your profile.</li>
                    }
                </ul>
            </div>

            <div class="card-footer bg-white d-flex">
                <form asp-action="Pass" method="post" class="flex-fill mr-2">
                    <input type="hidden" name="id" value="@current.Candidate.StudentId" />
                    <button type="submit" class="btn btn-outline-secondary btn-block" data-shortcut="n">
                        Not now
                    </button>
                </form>
                <form asp-action="Connect" method="post" class="flex-fill">
                    <input type="hidden" name="id" value="@current.Candidate.StudentId" />
                    <button type="submit" class="btn btn-primary btn-block" data-shortcut="c">
                        Connect
                    </button>
                </form>
            </div>
        </article>
    </div>

    <p class="text-center text-muted small mt-3 shortcut-hint">
        Press <kbd>C</kbd> to connect or <kbd>N</kbd> to skip.
    </p>
}

@section Scripts {
    <script>
        // Keyboard shortcuts for reviewing quickly. Ignored while typing in a field.
        document.addEventListener('keydown', function (event) {
            if (event.metaKey || event.ctrlKey || event.altKey) return;

            var tag = (event.target.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || tag === 'select') return;

            // Only single letters are valid shortcuts. Interpolating an arbitrary key
            // such as " or ] into the selector below would raise a SyntaxError.
            var key = event.key.toLowerCase();
            if (!/^[a-z]$/.test(key)) return;

            var button = document.querySelector('[data-shortcut="' + key + '"]');
            if (button) {
                event.preventDefault();
                button.click();
            }
        });
    </script>
}
