@model IReadOnlyList<MatchResult>
@{
    ViewData["Title"] = "Your matches";
    var remaining = Model.Count;
    var topThree = Model.Take(3).ToList();
    var upNext = Model.Skip(1).Take(3).ToList();
    var greatCount = Model.Count(m => m.Tier == MatchTier.Great);
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
    <div>
        <h1 class="page-title">Your matches</h1>
        <p class="page-subtitle mb-0" id="deck-subtitle"@(remaining == 0 ? " hidden" : "")>@remaining to review</p>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="List">See all matches</a>
</div>

@* Populated by site.js after an AJAX decision carries a message — same spot
   TempData["Sent"] renders into on a full page load. *@
<div id="deck-flash" aria-live="polite">
    @if (TempData["Sent"] != null)
    {
        <div class="alert alert-success py-2 small">@TempData["Sent"]</div>
    }
</div>

@if (!topThree.Any())
{
    <partial name="_EmptyDeck" />
}
else
{
    <div class="deck-layout" id="deck-layout">
        <div class="deck" id="deck" data-remaining="@remaining">
            <div class="match-stack" id="match-stack">
                @foreach (var match in topThree)
                {
                    <partial name="_MatchCard" model="match" />
                }
            </div>

            <p class="text-center small mt-3 shortcut-hint">
                Press <kbd>C</kbd> to connect or <kbd>N</kbd> to skip.
            </p>
        </div>

        <aside class="deck-rail" id="deck-rail">
            <div class="rail-card">
                <div class="section-label mb-2">In your deck</div>
                <div class="rail-stat">
                    <span class="rail-stat-value" id="rail-remaining">@remaining</span>
                    <span class="rail-stat-label" id="rail-remaining-label">@(remaining == 1 ? "student" : "students") to review</span>
                </div>
                @if (greatCount > 0)
                {
                    <div class="rail-stat mt-2" id="rail-great-wrap">
                        <span class="rail-stat-value" id="rail-great">@greatCount</span>
                        <span class="rail-stat-label" id="rail-great-label">great @(greatCount == 1 ? "match" : "matches")</span>
                    </div>
                }
            </div>

            @if (upNext.Any())
            {
                <div class="rail-card" id="rail-up-next">
                    <div class="section-label mb-2">Up next</div>
                    @foreach (var next in upNext)
                    {
                        <div class="up-next-item">
                            <partial name="_Avatar" model="next.Candidate" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-sm" }' />
                            <div class="min-width-0">
                                <div class="up-next-name">@next.Candidate.Name</div>
                                <div class="up-next-meta">@next.Candidate.Major</div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="rail-card">
                <div class="section-label mb-2">Not seeing enough?</div>
                <p class="text-muted small mb-2">
                    Matches come from students at your university who switched on the same
                    courses as you.
                </p>
                <a class="btn btn-outline-secondary btn-sm btn-block" asp-controller="Profile" asp-action="Edit">
                    Edit your schedule
                </a>
            </div>
        </aside>
    </div>

    @* Not rendered visibly (a <template>'s content never paints): the source
       of truth site.js clones from once the client-side stack runs dry, so
       the "reviewed everyone" copy only ever exists in one place. *@
    <template id="empty-deck-template">
        <partial name="_EmptyDeck" />
    </template>
}
