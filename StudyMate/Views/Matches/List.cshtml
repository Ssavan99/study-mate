@model IReadOnlyList<MatchResult>
@{
    ViewData["Title"] = "All matches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">All matches</h1>
        <span class="text-muted small">Ranked by score, best first</span>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Back to the deck</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No candidates left to review.</p>
}
else
{
    <div class="table-responsive">
        <table class="table match-table align-middle">
            <thead>
                <tr>
                    <th scope="col" class="rank-col">#</th>
                    <th scope="col">Student</th>
                    <th scope="col">Score</th>
                    <th scope="col">Why</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    var match = Model[i];
                    <tr>
                        <td class="text-muted">@(i + 1)</td>
                        <td>
                            <strong>@match.Candidate.Name</strong><br />
                            <span class="text-muted small">@match.Candidate.Major · Year @match.Candidate.Year</span>
                        </td>
                        <td>
                            <span class="score-pill">@match.Score</span>
                        </td>
                        <td class="small">
                            @foreach (var reason in match.Reasons)
                            {
                                <div class="reason-inline">
                                    <span class="reason-points">+@reason.Points</span> @reason.Text
                                </div>
                            }
                            @if (!match.Reasons.Any())
                            {
                                <span class="text-muted">Nothing in common yet</span>
                            }
                        </td>
                        <td class="text-right">
                            <form asp-action="Connect" method="post">
                                <input type="hidden" name="id" value="@match.Candidate.StudentId" />
                                <button type="submit" class="btn btn-sm btn-outline-primary">Connect</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
