@model ProfileEditViewModel
@{
    ViewData["Title"] = "Your profile";
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
    var blocks = new[] { TimeBlock.Morning, TimeBlock.Afternoon, TimeBlock.Evening };
    var selected = Model.SelectedSlots.ToHashSet();
    var departments = Model.UniversityCourses
        .Select(c => c.Department)
        .Distinct()
        .OrderBy(d => d)
        .ToList();
}

<div class="mb-4">
    <h1 class="page-title">Your profile</h1>
    <p class="page-subtitle">Your courses and availability decide who you match with.</p>
</div>

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Saved"]</div>
}
@if (TempData["PhotoError"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["PhotoError"]</div>
}
@if (TempData["CourseError"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["CourseError"]</div>
}

@* Course add/remove are their own posts, so they live outside the main profile
   form — HTML forbids nesting one form inside another. *@
<form id="addCourseForm" asp-action="AddCourse" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<section class="profile-section photo-upload">
    <h2>Photo</h2>
    <div class="d-flex align-items-center flex-wrap">
        <partial name="_Avatar" model="Model.CurrentStudent" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-lg" }' />
        <div class="ml-3">
            <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="form-inline">
                <div class="custom-file mr-2">
                    <input type="file" name="photo" id="photo" class="custom-file-input" accept="image/jpeg,image/png,image/webp" />
                    <label class="custom-file-label" for="photo">Choose an image</label>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Upload</button>
            </form>
            @if (Model.CurrentStudent?.PhotoData != null)
            {
                <form asp-action="RemovePhoto" method="post" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-link p-0">Remove photo</button>
                </form>
            }
            else
            {
                <p class="text-muted small mb-0 mt-2">No photo yet — showing a generated avatar. JPEG, PNG or WebP, up to 1MB.</p>
            }
        </div>
    </div>
</section>

<section class="profile-section">
    <h2>Your schedule</h2>
    <p class="text-muted small">
        Add every course you're taking, then switch on the ones you actually want a study
        partner for. Only courses switched on take part in matching — and only when the
        other student has switched the same course on too.
    </p>

    @if (Model.MyCourses.Any())
    {
        @foreach (var course in Model.MyCourses)
        {
            <div class="enrolled-course @(course.SeekingPartner ? "is-seeking" : "")">
                <div>
                    <div class="course-code">@course.Code</div>
                    <div class="course-title">@course.Title</div>
                </div>
                <div class="course-actions">
                    <label class="seek-toggle" title="Look for a study partner in this course">
                        <input type="checkbox" name="SeekingCourseIds" value="@course.CourseId"
                               form="profileForm" @(course.SeekingPartner ? "checked" : "") />
                        <span class="seek-track"></span>
                        <span>Finding a partner</span>
                    </label>
                    <button type="submit" name="courseId" value="@course.CourseId"
                            form="removeCourseForm" class="btn btn-sm btn-link text-muted p-0"
                            title="Remove @course.Code from your schedule">Remove</button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="course-empty">
            <strong>No courses yet.</strong>
            <div class="small mt-1">Add your first course below to start matching.</div>
        </div>
    }

    <div class="course-adder mt-3">
        <div class="form-group">
            <label for="deptSelect">Department</label>
            <select id="deptSelect" class="form-control">
                <option value="">Choose…</option>
                @foreach (var dept in departments)
                {
                    <option value="@dept">@dept</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="numberSelect">Course</label>
            <select id="numberSelect" class="form-control" disabled>
                <option value="">Choose a department first</option>
            </select>
        </div>
        <div class="form-group">
            <button type="submit" form="addCourseForm" name="code" value=""
                    id="addExistingBtn" class="btn btn-primary" disabled>Add to schedule</button>
        </div>
    </div>

    <details class="mt-3">
        <summary class="btn btn-sm btn-link p-0">Can't find your course? Request it.</summary>
        <form asp-action="RequestCourse" method="post" class="course-adder mt-2">
            <div class="course-adder">
            <div class="form-group">
                <label for="requestCode">Course code</label>
                <input type="text" id="requestCode" name="code" class="form-control" placeholder="CSCE 310" />
            </div>
            <div class="form-group form-group--grow">
                <label for="requestTitle">Title</label>
                <input type="text" id="requestTitle" name="title" class="form-control" placeholder="Data Structures and Algorithms" />
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-outline-secondary">Send request</button>
            </div>
        </div>
        </form>
    </details>
</section>

<form id="removeCourseForm" asp-action="RemoveCourse" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<form id="profileForm" asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <section class="profile-section">
        <h2>About you</h2>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group col-md-6">
                <label>University</label>
                <input value="@(Model.UniversityName ?? "Not yet verified")" class="form-control" readonly />
                <small class="form-text">Your university is set by a verified institutional sign-in.</small>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-9">
                <label asp-for="Major"></label>
                <input asp-for="Major" class="form-control" />
                <span asp-validation-for="Major" class="text-danger small"></span>
            </div>
            <div class="form-group col-md-3">
                <label asp-for="Year"></label>
                <select asp-for="Year" class="form-control">
                    <option value="1">1st year</option>
                    <option value="2">2nd year</option>
                    <option value="3">3rd year</option>
                    <option value="4">4th year</option>
                    <option value="5">Graduate</option>
                </select>
            </div>
        </div>
        <div class="form-group mb-0">
            <label asp-for="Bio"></label>
            <textarea asp-for="Bio" class="form-control" rows="2" maxlength="280"
                      placeholder="What you're working on, and what you want from a study partner."></textarea>
            <span asp-validation-for="Bio" class="text-danger small"></span>
        </div>
    </section>

    <section class="profile-section">
        <h2>When you are free</h2>
        <p class="text-muted small">Tick every block you could realistically meet in.</p>
        <div class="table-responsive">
            <table class="table table-sm availability-grid mb-0">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        @foreach (var day in days)
                        {
                            <th scope="col" class="text-center">@day.ToString().Substring(0, 3)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in blocks)
                    {
                        <tr>
                            <th scope="row" class="text-muted font-weight-normal">@block</th>
                            @foreach (var day in days)
                            {
                                var key = ProfileEditViewModel.SlotKey(day, block);
                                var id = $"slot-{key}";
                                <td class="text-center">
                                    <input type="checkbox" id="@id" name="SelectedSlots" value="@key"
                                           aria-label="@day @block"
                                           @(selected.Contains(key) ? "checked" : "") />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="profile-section">
        <h2>How you like to work</h2>
        <div class="form-row mb-0">
            <div class="form-group col-md-4 mb-0">
                <label asp-for="PreferredNoise"></label>
                <select asp-for="PreferredNoise" class="form-control"
                        asp-items="Html.GetEnumSelectList<NoiseLevel>()"></select>
            </div>
            <div class="form-group col-md-4 mb-0">
                <label asp-for="Pace"></label>
                <select asp-for="Pace" class="form-control"
                        asp-items="Html.GetEnumSelectList<StudyPace>()"></select>
            </div>
            <div class="form-group col-md-4 mb-0">
                <label asp-for="PreferredGroupSize"></label>
                <select asp-for="PreferredGroupSize" class="form-control"
                        asp-items="Html.GetEnumSelectList<GroupSize>()"></select>
            </div>
        </div>
    </section>

    <div class="d-flex align-items-center">
        <button type="submit" class="btn btn-primary">Save profile</button>
        <a class="btn btn-link ml-2" asp-controller="Matches" asp-action="Index">Back to matches</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bootstrap 4's custom-file input doesn't update its own label.
        document.getElementById('photo')?.addEventListener('change', function (event) {
            var label = event.target.nextElementSibling;
            if (label && event.target.files.length > 0) {
                label.textContent = event.target.files[0].name;
            }
        });

        // Course picker: choosing a department narrows the second dropdown to that
        // department's courses. The catalog is emitted server-side and already scoped
        // to this student's university, so there is nothing to fetch.
        (function () {
            var catalog = @Html.Raw(Json.Serialize(
                Model.UniversityCourses.Select(c => new { dept = c.Department, code = c.Code, title = c.Title })));
            var enrolled = @Html.Raw(Json.Serialize(Model.MyCourses.Select(c => c.Code)));

            var deptSelect = document.getElementById('deptSelect');
            var numberSelect = document.getElementById('numberSelect');
            var addBtn = document.getElementById('addExistingBtn');
            if (!deptSelect || !numberSelect || !addBtn) return;

            var enrolledSet = new Set(enrolled);

            deptSelect.addEventListener('change', function () {
                var dept = deptSelect.value;
                numberSelect.innerHTML = '';

                if (!dept) {
                    numberSelect.disabled = true;
                    numberSelect.innerHTML = '<option value="">Choose a department first</option>';
                    addBtn.disabled = true;
                    return;
                }

                var matches = catalog.filter(function (c) { return c.dept === dept; });
                var placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = 'Choose a course…';
                numberSelect.appendChild(placeholder);

                matches.forEach(function (c) {
                    var opt = document.createElement('option');
                    opt.value = c.code;
                    // Courses already on the schedule stay visible but unselectable,
                    // so the list doesn't silently change shape between visits.
                    opt.textContent = c.code + ' — ' + c.title + (enrolledSet.has(c.code) ? '  (added)' : '');
                    opt.disabled = enrolledSet.has(c.code);
                    numberSelect.appendChild(opt);
                });

                numberSelect.disabled = false;
                addBtn.disabled = true;
            });

            numberSelect.addEventListener('change', function () {
                addBtn.value = numberSelect.value;
                addBtn.disabled = !numberSelect.value;
            });
        })();
    </script>
}
