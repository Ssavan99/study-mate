@model ProfileEditViewModel
@{
    ViewData["Title"] = "Your profile";
    var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
    var blocks = new[] { TimeBlock.Morning, TimeBlock.Afternoon, TimeBlock.Evening };
    var selected = Model.SelectedSlots.ToHashSet();
}

<h1 class="h4 mb-1">Your profile</h1>
<p class="text-muted small mb-4">
    Courses and availability drive your matches — the more accurate these are, the better the ranking.
</p>

@if (TempData["Saved"] != null)
{
    <div class="alert alert-success py-2 small">@TempData["Saved"]</div>
}
@if (TempData["PhotoError"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["PhotoError"]</div>
}
@if (TempData["CourseError"] != null)
{
    <div class="alert alert-danger py-2 small">@TempData["CourseError"]</div>
}

@* The "add a class" fields render inside the main profile form below, but a form
   cannot be nested inside another form in valid HTML. This standalone form has no
   visible fields of its own — its inputs bind to it via the form="addCourseSubmit"
   attribute regardless of where they sit in the document. *@
<form id="addCourseSubmit" asp-action="AddCourse" method="post" class="d-none">
    @Html.AntiForgeryToken()
</form>

<section class="profile-section">
    <h2 class="h6 text-uppercase text-muted">Photo</h2>
    <div class="d-flex align-items-center">
        <partial name="_Avatar" model="Model.CurrentStudent" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "avatar-lg" }' />
        <div class="ml-3">
            <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="form-inline">
                <div class="custom-file mr-2" style="width: auto;">
                    <input type="file" name="photo" id="photo" class="custom-file-input" accept="image/jpeg,image/png,image/webp" />
                    <label class="custom-file-label" for="photo">Choose an image</label>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-secondary">Upload</button>
            </form>
            @if (Model.CurrentStudent?.PhotoData != null)
            {
                <form asp-action="RemovePhoto" method="post" class="mt-2">
                    <button type="submit" class="btn btn-sm btn-link p-0">Remove photo</button>
                </form>
            }
            else
            {
                <p class="text-muted small mb-0 mt-2">No photo yet — showing a generated avatar. JPEG, PNG or WebP, up to 1MB.</p>
            }
        </div>
    </div>
</section>

<form asp-action="Edit" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <section class="profile-section">
        <h2 class="h6 text-uppercase text-muted">About you</h2>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="form-group col-md-6">
                <label asp-for="University"></label>
                <input asp-for="University" class="form-control" />
                <span asp-validation-for="University" class="text-danger small"></span>
                <small class="form-text text-muted">You only match with students at the same university.</small>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-10">
                <label asp-for="Major"></label>
                <input asp-for="Major" class="form-control" />
                <span asp-validation-for="Major" class="text-danger small"></span>
            </div>
            <div class="form-group col-md-2">
                <label asp-for="Year"></label>
                <select asp-for="Year" class="form-control">
                    <option value="1">1st</option>
                    <option value="2">2nd</option>
                    <option value="3">3rd</option>
                    <option value="4">4th</option>
                    <option value="5">Grad</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label asp-for="Bio"></label>
            <textarea asp-for="Bio" class="form-control" rows="2" maxlength="280"
                      placeholder="What you are working on, and what you want from a study partner."></textarea>
            <span asp-validation-for="Bio" class="text-danger small"></span>
        </div>
    </section>

    <section class="profile-section">
        <h2 class="h6 text-uppercase text-muted">Courses</h2>
        <p class="text-muted small">Shared courses are the strongest signal in the match score.</p>
        <div class="course-grid">
            @foreach (var group in Model.AllCourses.GroupBy(c => c.Department).OrderBy(g => g.Key))
            {
                <fieldset class="course-group">
                    <legend class="h6 small text-muted">@group.Key</legend>
                    @foreach (var course in group)
                    {
                        var id = $"course-{course.CourseId}";
                        <div class="custom-control custom-checkbox">
                            <input class="custom-control-input" type="checkbox" id="@id"
                                   name="SelectedCourseIds" value="@course.CourseId"
                                   @(Model.SelectedCourseIds.Contains(course.CourseId) ? "checked" : "") />
                            <label class="custom-control-label" for="@id">
                                <strong>@course.Code</strong>
                                <span class="text-muted d-block small">@course.Title</span>
                            </label>
                        </div>
                    }
                </fieldset>
            }
        </div>
    </section>

    <div class="text-right mt-n3 mb-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="collapse" data-target="#addCourseForm">
            + Add a class not listed above
        </button>
    </div>

    <section class="profile-section collapse" id="addCourseForm">
        <h2 class="h6 text-uppercase text-muted">Add a class</h2>
        <p class="text-muted small">
            This can't be checked against a real course catalog, so enter it as a department
            and number, like "CSCE 310". If someone else already added that course, you'll
            join theirs rather than creating a duplicate.
        </p>
        <div class="form-row align-items-end">
            <div class="form-group col-sm-3 mb-0">
                <label for="newCourseCode">Course code</label>
                <input type="text" id="newCourseCode" name="code" form="addCourseSubmit" class="form-control" placeholder="CSCE 310" />
            </div>
            <div class="form-group col-sm-6 mb-0">
                <label for="newCourseTitle">Title</label>
                <input type="text" id="newCourseTitle" name="title" form="addCourseSubmit" class="form-control" placeholder="Data Structures and Algorithms" />
            </div>
            <div class="form-group col-sm-3 mb-0">
                <button type="submit" form="addCourseSubmit" class="btn btn-outline-secondary btn-block">Add course</button>
            </div>
        </div>
    </section>

    <section class="profile-section">
        <h2 class="h6 text-uppercase text-muted">When you are free</h2>
        <p class="text-muted small">Tick every block you could realistically meet in.</p>
        <div class="table-responsive">
            <table class="table table-sm availability-grid">
                <thead>
                    <tr>
                        <th scope="col"></th>
                        @foreach (var day in days)
                        {
                            <th scope="col" class="text-center">@day.ToString().Substring(0, 3)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var block in blocks)
                    {
                        <tr>
                            <th scope="row" class="text-muted font-weight-normal">@block</th>
                            @foreach (var day in days)
                            {
                                var key = ProfileEditViewModel.SlotKey(day, block);
                                var id = $"slot-{key}";
                                <td class="text-center">
                                    <input type="checkbox" id="@id" name="SelectedSlots" value="@key"
                                           aria-label="@day @block"
                                           @(selected.Contains(key) ? "checked" : "") />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="profile-section">
        <h2 class="h6 text-uppercase text-muted">How you like to work</h2>
        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="PreferredNoise"></label>
                <select asp-for="PreferredNoise" class="form-control"
                        asp-items="Html.GetEnumSelectList<NoiseLevel>()"></select>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="Pace"></label>
                <select asp-for="Pace" class="form-control"
                        asp-items="Html.GetEnumSelectList<StudyPace>()"></select>
            </div>
            <div class="form-group col-md-4">
                <label asp-for="PreferredGroupSize"></label>
                <select asp-for="PreferredGroupSize" class="form-control"
                        asp-items="Html.GetEnumSelectList<GroupSize>()"></select>
            </div>
        </div>
    </section>

    <button type="submit" class="btn btn-primary">Save profile</button>
    <a class="btn btn-link" asp-controller="Matches" asp-action="Index">Back to matches</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bootstrap 4's custom-file input doesn't update its own label; do it by hand.
        document.getElementById('photo')?.addEventListener('change', function (event) {
            var label = event.target.nextElementSibling;
            if (label && event.target.files.length > 0) {
                label.textContent = event.target.files[0].name;
            }
        });
    </script>
}
