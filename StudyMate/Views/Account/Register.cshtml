@model StudyMate.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3 mb-1">Create an account</h1>
        <p class="text-muted small mb-3">
            This is a demonstration deployment. The database is reset whenever the service
            restarts, so accounts created here are temporary.
        </p>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" autocomplete="name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-sm-8">
                    <label asp-for="Major"></label>
                    <input asp-for="Major" class="form-control" placeholder="Computer Science" />
                    <span asp-validation-for="Major" class="text-danger small"></span>
                </div>
                <div class="form-group col-sm-4">
                    <label asp-for="Year"></label>
                    <select asp-for="Year" class="form-control">
                        <option value="1">1st year</option>
                        <option value="2">2nd year</option>
                        <option value="3">3rd year</option>
                        <option value="4">4th year</option>
                        <option value="5">Graduate</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-sm-6">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-group col-sm-6">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Create account</button>
        </form>

        <p class="text-muted small mt-3 mb-0">University affiliation is assigned only after a verified institutional sign-in.</p>

        <p class="mt-3 mb-0 text-muted small">
            Already registered? <a asp-action="Login">Log in</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
