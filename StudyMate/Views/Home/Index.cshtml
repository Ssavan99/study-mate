@model List<Student>
@{
    ViewData["Title"] = "Find a study partner";
}

<div class="hero text-center">
    <h1 class="display-4 mb-2">Study with people in your actual courses</h1>
    <p class="lead text-muted mb-4">
        StudyMate ranks other students by how well you would actually study together —
        shared courses first, then when you are both free, then how you like to work.
        Every match shows its reasoning.
    </p>
</div>

@if (Model.Any())
{
    <div class="demo-panel">
        <h2 class="h5 mb-1">Try it now</h2>
        <p class="text-muted small mb-3">
            Sign in as one of these students to see their matches straight away. No registration needed.
        </p>

        <div class="row">
            @foreach (var persona in Model)
            {
                <div class="col-md-6 col-lg-3 mb-3">
                    <div class="card h-100 persona-card">
                        <div class="card-body d-flex flex-column">
                            <h3 class="h6 mb-1">@persona.Name</h3>
                            <p class="text-muted small mb-2">
                                @persona.Major · Year @persona.Year<br />
                                @persona.Enrollments.Count courses
                            </p>
                            <p class="small flex-grow-1 mb-3">@persona.Bio</p>
                            <form asp-controller="Account" asp-action="DemoSignIn" method="post">
                                <input type="hidden" name="id" value="@persona.StudentId" />
                                <button type="submit" class="btn btn-primary btn-sm btn-block">
                                    Sign in as @persona.Name.Split(' ')[0]
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <p class="text-muted small mb-0">
            Prefer your own account? <a asp-controller="Account" asp-action="Register">Register</a> —
            though the demo profiles have courses and availability already filled in.
        </p>
    </div>
}
else
{
    <div class="alert alert-warning">
        <strong>No demo profiles are loaded.</strong>
        <a asp-controller="Account" asp-action="Register">Register an account</a> to get started.
    </div>
}

<div class="row mt-5 how-it-works">
    <div class="col-md-4">
        <div class="step-number">1</div>
        <h3 class="h6">Say what you are taking</h3>
        <p class="text-muted small">
            Pick your courses, mark the blocks you are free during the week, and say
            whether you want silence or discussion.
        </p>
    </div>
    <div class="col-md-4">
        <div class="step-number">2</div>
        <h3 class="h6">Review ranked matches</h3>
        <p class="text-muted small">
            Candidates come one at a time, best first, with the reasons you matched
            spelled out for each one.
        </p>
    </div>
    <div class="col-md-4">
        <div class="step-number">3</div>
        <h3 class="h6">Connect</h3>
        <p class="text-muted small">
            Send a study request. If they accept, you both see the connection and can
            take it from there.
        </p>
    </div>
</div>
