@{
    ViewData["Title"] = "Page not found";
}

<div class="empty-state text-center py-5">
    <p class="section-label mb-2">404</p>
    <h1 class="h4 mb-2">This page does not exist</h1>
    <p class="text-muted">
        The link might be broken, or the page may have moved. Let's get you back on track.
    </p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the start</a>
</div>
