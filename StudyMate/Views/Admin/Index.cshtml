@model StudyMate.Models.ViewModels.AdminDashboardViewModel
@{ViewData["Title"]="Admin dashboard";var acceptance=Model.RequestsSent==0?0:100m*Model.AcceptedRequests/Model.RequestsSent;}
<h1 class="page-title">University dashboard</h1><p class="page-subtitle">Aggregate activity only — no individual student data is shown here.</p>
<div class="row"><div class="col-md-4"><div class="rail-card"><div class="section-label">Students</div><strong>@Model.Students</strong><div class="small text-muted">@Model.VerifiedStudents domain-verified</div></div></div><div class="col-md-4"><div class="rail-card"><div class="section-label">Requests</div><strong>@Model.RequestsSent</strong><div class="small text-muted">@acceptance.ToString("0.0")% accepted</div></div></div><div class="col-md-4"><div class="rail-card"><div class="section-label">Sessions</div><strong>@Model.SessionsCreated</strong><div class="small text-muted">@Model.AverageFillPercent.ToString("0.0")% average fill</div></div></div></div>
<section class="mt-4"><h2 class="section-label">Safety</h2><p>@Model.OpenReports open reports · @(Model.MedianResolutionHours?.ToString("0.0") ?? "—") median hours to resolution</p><h2 class="section-label mt-4">Most active courses</h2><table class="table"><tbody>@foreach(var row in Model.ActiveCourses){<tr><td>@row.Course</td><td>@row.Students seeking a partner</td></tr>}</tbody></table></section>
